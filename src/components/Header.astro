---
interface Props { home?: boolean }
const { home = false } = Astro.props;
---

<style is:global>

  :root {
    --bd-dark: #0A0D11;
    --bd-kupfer: #C78A6A;
    --bd-kupfer-dark: #B7795C;
    --bd-creme: #F3EDE6;
    --bd-weiss: #FFFFFF;
    --bd-border: rgba(255,255,255,0.10);
  }

  /* =========================================================
     HEADER

     WICHTIG:
     NICHT MEHR FIXED.

     Der Header liegt oben über dem Hero und scrollt
     anschließend ganz normal mit der Seite nach oben weg.
  ========================================================= */

  #bd-header {
    position: absolute !important;

    top: 0 !important;
    left: 0 !important;
    right: 0 !important;

    width: 100% !important;

    z-index: 999999 !important;

    box-sizing: border-box;

    background:
      transparent !important;

    background-color:
      transparent !important;

    border:
      0 !important;

    box-shadow:
      none !important;
  }

  /* =========================================================
     LANDINGPAGE

     TRANSPARENT ÜBER DEM HERO
  ========================================================= */

  #bd-header.bd-home:not(.bd-menu-active) {

    background:
      transparent !important;

    background-color:
      transparent !important;

    box-shadow:
      none !important;

    border:
      0 !important;

    backdrop-filter:
      none !important;

    -webkit-backdrop-filter:
      none !important;
  }

  /* =========================================================
     UNTERSEITEN

     DUNKLER HEADER
     scrollt ebenfalls normal mit der Seite weg
  ========================================================= */

  #bd-header.bd-inner-page {

    background:
      var(--bd-dark) !important;

    background-color:
      var(--bd-dark) !important;

    border-bottom:
      1px solid
      var(--bd-border) !important;

    box-shadow:
      0 6px 24px
      rgba(0,0,0,.18) !important;
  }

  /* =========================================================
     MOBILES MENÜ GEÖFFNET

     HEADER + MENÜ = EINE DUNKLE FLÄCHE
  ========================================================= */

  #bd-header.bd-menu-active,
  #bd-header.bd-home.bd-menu-active,
  #bd-header.bd-inner-page.bd-menu-active {

    background:
      var(--bd-dark) !important;

    background-color:
      var(--bd-dark) !important;

    border:
      0 !important;

    box-shadow:
      none !important;

    backdrop-filter:
      none !important;

    -webkit-backdrop-filter:
      none !important;
  }

  /* =========================================================
     HEADER INNER
  ========================================================= */

  .bd-header-inner {

    position: relative;

    width:
      min(
        1440px,
        calc(100% - 80px)
      );

    height: 94px;

    margin:
      0 auto;

    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    gap:
      40px;

    box-sizing:
      border-box;

    z-index:
      3;
  }

  /* =========================================================
     LOGO
  ========================================================= */

  .bd-header-logo {

    position:
      relative;

    display:
      flex;

    align-items:
      center;

    flex-shrink:
      0;

    text-decoration:
      none;

    z-index:
      5;
  }

  .bd-header-logo img {

    display:
      block;

    width:
      auto;

    height:
      55px;

    object-fit:
      contain;

    transition:
      transform .25s ease,
      opacity .25s ease;
  }

  .bd-header-logo:hover img {

    transform:
      scale(1.02);

    opacity:
      .95;
  }

  /* =========================================================
     DESKTOP NAVIGATION
  ========================================================= */

  .bd-header-nav {

    display:
      flex;

    align-items:
      center;

    gap:
      42px;
  }

  .bd-header-nav a {

    position:
      relative;

    color:
      var(--bd-creme);

    text-decoration:
      none;

    font-family:
      Arial,
      Helvetica,
      sans-serif;

    font-size:
      12px;

    font-weight:
      500;

    letter-spacing:
      .12em;

    text-transform:
      uppercase;

    background:
      transparent !important;

    transition:
      color .25s ease,
      letter-spacing .25s ease,
      transform .25s ease;
  }

  /* =========================================================
     KEINE HOVER-BALKEN
  ========================================================= */

  .bd-header-nav a::before,
  .bd-header-nav a::after {

    display:
      none !important;

    content:
      none !important;
  }

  /* =========================================================
     DESKTOP HOVER
  ========================================================= */

  .bd-header-nav
  a:not(.bd-contact-button):hover,

  .bd-header-nav
  a:not(.bd-contact-button):focus-visible {

    color:
      var(--bd-kupfer);

    letter-spacing:
      .16em;

    transform:
      translateY(-1px);

    background:
      transparent !important;
  }

  /* =========================================================
     KONTAKT BUTTON
  ========================================================= */

  .bd-contact-button {

    display:
      inline-flex;

    align-items:
      center;

    justify-content:
      center;

    min-height:
      48px;

    padding:
      0 26px;

    background:
      var(--bd-kupfer) !important;

    color:
      var(--bd-weiss) !important;

    border:
      1px solid
      var(--bd-kupfer);

    letter-spacing:
      .12em;

    transition:
      background-color .25s ease,
      border-color .25s ease,
      color .25s ease,
      letter-spacing .25s ease,
      transform .25s ease;
  }

  .bd-contact-button:hover,
  .bd-contact-button:focus-visible {

    background:
      var(--bd-kupfer-dark) !important;

    border-color:
      var(--bd-kupfer-dark);

    color:
      var(--bd-weiss) !important;

    letter-spacing:
      .15em;

    transform:
      translateY(-1px);
  }

  /* =========================================================
     MOBILE BURGER
  ========================================================= */

  .bd-mobile-toggle {

    display:
      none;

    position:
      relative;

    width:
      48px;

    height:
      48px;

    flex:
      0 0 48px;

    padding:
      0;

    margin:
      0;

    border:
      0;

    appearance:
      none;

    -webkit-appearance:
      none;

    background:
      transparent !important;

    cursor:
      pointer;

    z-index:
      10;
  }

  .bd-mobile-toggle span {

    position:
      absolute;

    left:
      50%;

    display:
      block;

    width:
      26px;

    height:
      1.5px;

    margin:
      0;

    background:
      var(--bd-creme) !important;

    transform:
      translateX(-50%);

    transform-origin:
      center;

    opacity:
      1;

    transition:
      top .28s ease,
      transform .28s ease,
      opacity .20s ease,
      background-color .25s ease;
  }

  .bd-mobile-toggle span:nth-child(1) {
    top: 15px;
  }

  .bd-mobile-toggle span:nth-child(2) {
    top: 23px;
  }

  .bd-mobile-toggle span:nth-child(3) {
    top: 31px;
  }

  .bd-mobile-toggle:hover span {

    background:
      var(--bd-kupfer) !important;
  }

  /* =========================================================
     BURGER → X
  ========================================================= */

  .bd-mobile-toggle.bd-open
  span:nth-child(1) {

    top:
      23px;

    transform:
      translateX(-50%)
      rotate(45deg);
  }

  .bd-mobile-toggle.bd-open
  span:nth-child(2) {

    opacity:
      0;
  }

  .bd-mobile-toggle.bd-open
  span:nth-child(3) {

    top:
      23px;

    transform:
      translateX(-50%)
      rotate(-45deg);
  }

  /* =========================================================
     TABLET + MOBILE
  ========================================================= */

  @media screen and (max-width: 990px) {

    #bd-header {

      overflow:
        visible !important;
    }

    .bd-header-inner {

      width:
        calc(100% - 40px);

      height:
        80px;

      overflow:
        visible !important;
    }

    .bd-header-logo img {

      height:
        45px;
    }

    .bd-mobile-toggle {

      display:
        block !important;

      visibility:
        visible !important;

      opacity:
        1 !important;

      pointer-events:
        auto !important;
    }

    /* =======================================================
       MOBILES MENÜ

       Nicht position:fixed.
       Es hängt direkt unter dem Header und scrollt
       zusammen mit Header/Hero weg.
    ======================================================== */

    .bd-header-nav {

      position:
        absolute !important;

      top:
        80px !important;

      left:
        0 !important;

      right:
        0 !important;

      width:
        100% !important;

      max-width:
        none !important;

      margin:
        0 !important;

      padding:
        18px
        24px
        26px !important;

      display:
        flex !important;

      flex-direction:
        column !important;

      align-items:
        stretch !important;

      gap:
        0 !important;

      background:
        var(--bd-dark) !important;

      background-color:
        var(--bd-dark) !important;

      border-top:
        0 !important;

      border-left:
        0 !important;

      border-right:
        0 !important;

      border-bottom:
        1px solid
        var(--bd-border) !important;

      box-shadow:
        0 20px 40px
        rgba(0,0,0,.38) !important;

      box-sizing:
        border-box !important;

      z-index:
        999998 !important;

      /* GESCHLOSSEN */

      opacity:
        0 !important;

      visibility:
        hidden !important;

      pointer-events:
        none !important;

      transform:
        translateY(-8px) !important;

      transition:
        opacity .28s ease,
        transform .28s ease,
        visibility .28s ease !important;
    }

    /* =======================================================
       MENÜ GEÖFFNET
    ======================================================== */

    .bd-header-nav.bd-open {

      opacity:
        1 !important;

      visibility:
        visible !important;

      pointer-events:
        auto !important;

      transform:
        translateY(0) !important;
    }

    /* =======================================================
       MOBILE LINKS
    ======================================================== */

    .bd-header-nav a {

      position:
        relative;

      width:
        100% !important;

      min-height:
        56px;

      display:
        flex !important;

      align-items:
        center;

      justify-content:
        center;

      padding:
        0 10px !important;

      margin:
        0 !important;

      color:
        var(--bd-creme) !important;

      font-size:
        13px;

      text-align:
        center;

      text-decoration:
        none;

      background:
        transparent !important;

      border-bottom:
        1px solid
        rgba(255,255,255,.07);

      box-sizing:
        border-box;
    }

    /* =======================================================
       MOBILE HOVER
    ======================================================== */

    .bd-header-nav
    a:not(.bd-contact-button):hover,

    .bd-header-nav
    a:not(.bd-contact-button):focus-visible {

      color:
        var(--bd-kupfer) !important;

      letter-spacing:
        .15em;

      transform:
        none;

      background:
        transparent !important;
    }

    /* =======================================================
       MOBILE KONTAKT
    ======================================================== */

    .bd-header-nav
    .bd-contact-button {

      width:
        100% !important;

      min-height:
        54px;

      margin-top:
        14px !important;

      padding:
        0 25px !important;

      background:
        var(--bd-kupfer) !important;

      color:
        var(--bd-weiss) !important;

      border:
        1px solid
        var(--bd-kupfer) !important;
    }

    .bd-header-nav
    .bd-contact-button:hover,

    .bd-header-nav
    .bd-contact-button:focus-visible {

      background:
        var(--bd-kupfer-dark) !important;

      border-color:
        var(--bd-kupfer-dark) !important;

      color:
        var(--bd-weiss) !important;

      letter-spacing:
        .14em;
    }

  }

  /* =========================================================
     SMALL MOBILE
  ========================================================= */

  @media screen and (max-width: 560px) {

    .bd-header-inner {

      width:
        calc(100% - 28px);

      height:
        72px;
    }

    .bd-header-logo img {

      height:
        39px;

      max-width:
        225px;
    }

    .bd-mobile-toggle {

      width:
        44px;

      height:
        44px;

      flex-basis:
        44px;
    }

    .bd-header-nav {

      top:
        72px !important;

      padding:
        14px
        18px
        22px !important;
    }

  }

  /* =========================================================
     REDUCED MOTION
  ========================================================= */

  @media (prefers-reduced-motion: reduce) {

    .bd-header-nav,

    .bd-header-nav a,

    .bd-header-logo img,

    .bd-mobile-toggle span {

      transition:
        none !important;
    }

  }

</style>

<!-- =========================================================
     HEADER
========================================================= -->

<header
  id="bd-header"
  class={home ? "bd-home" : "bd-inner-page"}
>

  <div class="bd-header-inner">

    <!-- LOGO -->

    <a
      href="/"
      class="bd-header-logo"
      aria-label="Bräuer Digital Startseite"
    >

      <img
        src="/images/Logoheader.png"
        alt="Bräuer Digital"
        loading="eager"
        width="420"
        height="120"
      >

    </a>

    <!-- MOBILE BURGER -->

    <button
      type="button"
      class="bd-mobile-toggle"
      id="bd-mobile-toggle"
      aria-label="Menü öffnen"
      aria-expanded="false"
      aria-controls="bd-header-nav"
    >

      <span></span>
      <span></span>
      <span></span>

    </button>

    <!-- NAVIGATION -->

    <nav
      class="bd-header-nav"
      id="bd-header-nav"
      aria-label="Hauptnavigation"
    >

      <a href="/leistungen">
        Leistungen
      </a>

      <a href="/ueber-mich">
        Über mich
      </a>

      <a href="/ablauf">
        Ablauf
      </a>

      <a
        href="/kontakt"
        class="bd-contact-button"
      >
        Kontakt
      </a>

    </nav>

  </div>

</header>

<script is:inline>
(function() {

  function initBraeuerHeader() {

    const header =
      document.getElementById(
        "bd-header"
      );

    const toggle =
      document.getElementById(
        "bd-mobile-toggle"
      );

    const nav =
      document.getElementById(
        "bd-header-nav"
      );

    if (
      !header ||
      !toggle ||
      !nav
    ) {

      return;
    }

    /* =======================================================
       DOPPELTE INITIALISIERUNG VERHINDERN
    ======================================================== */

    if (
      toggle.dataset.bdInitialized ===
      "true"
    ) {

      return;
    }

    toggle.dataset.bdInitialized =
      "true";

    /* =======================================================
       MENÜ ÖFFNEN
    ======================================================== */

    function openMenu() {

      nav.classList.add(
        "bd-open"
      );

      toggle.classList.add(
        "bd-open"
      );

      header.classList.add(
        "bd-menu-active"
      );

      header.style.setProperty(
        "background-color",
        "#0A0D11",
        "important"
      );

      header.style.setProperty(
        "background",
        "#0A0D11",
        "important"
      );

      toggle.setAttribute(
        "aria-expanded",
        "true"
      );

      toggle.setAttribute(
        "aria-label",
        "Menü schließen"
      );

    }

    /* =======================================================
       MENÜ SCHLIESSEN
    ======================================================== */

    function closeMenu() {

      nav.classList.remove(
        "bd-open"
      );

      toggle.classList.remove(
        "bd-open"
      );

      header.classList.remove(
        "bd-menu-active"
      );

      if (
        header.classList.contains(
          "bd-home"
        )
      ) {

        header.style.setProperty(
          "background-color",
          "transparent",
          "important"
        );

        header.style.setProperty(
          "background",
          "transparent",
          "important"
        );

      } else {

        header.style.setProperty(
          "background-color",
          "#0A0D11",
          "important"
        );

        header.style.setProperty(
          "background",
          "#0A0D11",
          "important"
        );

      }

      toggle.setAttribute(
        "aria-expanded",
        "false"
      );

      toggle.setAttribute(
        "aria-label",
        "Menü öffnen"
      );

    }

    /* =======================================================
       BURGER KLICK
    ======================================================== */

    toggle.addEventListener(
      "click",

      function(event) {

        event.preventDefault();

        event.stopPropagation();

        if (
          nav.classList.contains(
            "bd-open"
          )
        ) {

          closeMenu();

        } else {

          openMenu();

        }

      }
    );

    /* =======================================================
       NAVIGATION LINK
    ======================================================== */

    nav
      .querySelectorAll("a")
      .forEach(function(link) {

        link.addEventListener(
          "click",
          closeMenu
        );

      });

    /* =======================================================
       ESC
    ======================================================== */

    document.addEventListener(
      "keydown",

      function(event) {

        if (
          event.key === "Escape" &&
          nav.classList.contains(
            "bd-open"
          )
        ) {

          closeMenu();

          toggle.focus();

        }

      }
    );

    /* =======================================================
       DESKTOP WECHSEL
    ======================================================== */

    window.addEventListener(
      "resize",

      function() {

        if (
          window.innerWidth > 990 &&
          nav.classList.contains(
            "bd-open"
          )
        ) {

          closeMenu();

        }

      }
    );

  }

  /* =========================================================
     INITIALISIERUNG
  ========================================================= */

  if (
    document.readyState ===
    "loading"
  ) {

    document.addEventListener(
      "DOMContentLoaded",
      initBraeuerHeader,
      {
        once: true
      }
    );

  } else {

    initBraeuerHeader();

  }

  })();
</script>
