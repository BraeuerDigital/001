<style is:global>
  /* =========================================================
     BRÄUER.DIGITAL – LEISTUNGS-TEASER
  ========================================================= */

  #bd-services-teaser {
    --bd-dark: #18181F;
    --bd-copper: #C78A6A;
    --bd-cream: #F3EDE6;
    --bd-text-soft: #6E6863;
    --bd-line: rgba(24, 24, 31, 0.16);

    position: relative;

    width: 100%;
    max-width: 100%;

    box-sizing: border-box;

    background:
      linear-gradient(
        180deg,
        #18181F 0px,
        #29272A 24px,
        #5A5350 48px,
        #A79C94 72px,
        #D8CFC7 96px,
        #F3EDE6 125px,
        #F3EDE6 100%
      );

    padding:
      115px
      6%
      68px;

    overflow-x: clip;
    overflow-y: visible;

    isolation: isolate;

    z-index: 2;
  }

  /* =========================================================
     HERO → LEISTUNGEN ÜBERGANG
  ========================================================= */

  #bd-services-teaser::before {
    content: "";

    position: absolute;

    top: -55px;
    left: 0;
    right: 0;

    width: 100%;
    height: 150px;

    box-sizing: border-box;

    pointer-events: none;

    background:
      linear-gradient(
        180deg,

        rgba(24, 24, 31, 0.00) 0%,
        rgba(24, 24, 31, 0.18) 16%,
        rgba(24, 24, 31, 0.52) 35%,
        rgba(41, 39, 42, 0.82) 50%,
        rgba(90, 83, 80, 0.72) 65%,
        rgba(167, 156, 148, 0.48) 80%,
        rgba(216, 207, 199, 0.18) 92%,
        rgba(243, 237, 230, 0.00) 100%
      );

    filter: blur(20px);
    -webkit-filter: blur(20px);

    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);

    transform: none;

    z-index: 0;
  }

  /* =========================================================
     INNER
  ========================================================= */

  #bd-services-teaser .bd-services-inner {
    position: relative;

    z-index: 5;

    width: min(1320px, 100%);
    max-width: 100%;

    margin: 0 auto;

    box-sizing: border-box;
  }

  /* =========================================================
     INTRO
  ========================================================= */

  #bd-services-teaser .bd-services-intro {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, .9fr);

    gap: 70px;

    align-items: end;

    margin-bottom: 42px;

    min-width: 0;
  }

  /* =========================================================
     KICKER
  ========================================================= */

  #bd-services-teaser .bd-services-kicker {
    margin-bottom: 13px;

    color: var(--bd-copper);

    font-family:
      Arial,
      Helvetica,
      sans-serif;

    font-size: 10px;
    font-weight: 500;
    line-height: 1.3;

    letter-spacing: .19em;

    text-transform: uppercase;
  }

  /* =========================================================
     HEADLINE
  ========================================================= */

  #bd-services-teaser .bd-services-title {
    margin: 0;

    color: var(--bd-dark);

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size:
      clamp(
        35px,
        3.6vw,
        54px
      );

    font-weight: 400;
    line-height: 1.05;

    letter-spacing: -.025em;

    overflow-wrap: break-word;
  }

  /* =========================================================
     INTRO TEXT
  ========================================================= */

  #bd-services-teaser .bd-services-description {
    max-width: 530px;

    margin: 0;

    color: var(--bd-text-soft);

    font-family:
      Arial,
      Helvetica,
      sans-serif;

    font-size: 15px;
    font-weight: 400;
    line-height: 1.7;
  }

  /* =========================================================
     LEISTUNGEN GRID
  ========================================================= */

  #bd-services-teaser .bd-services-grid {
    position: relative;

    z-index: 5;

    display: grid;

    grid-template-columns:
      repeat(
        3,
        minmax(0, 1fr)
      );

    width: 100%;
    max-width: 100%;

    box-sizing: border-box;

    border-top:
      1px solid
      var(--bd-line);

    border-bottom:
      1px solid
      var(--bd-line);
  }

  /* =========================================================
     EINZELNE LEISTUNG
  ========================================================= */

  #bd-services-teaser .bd-service-item {
    position: relative;

    display: flex;
    flex-direction: column;
    justify-content: center;

    min-width: 0;

    min-height: 225px;

    padding:
      35px
      38px
      35px
      0;

    box-sizing: border-box;
  }

  #bd-services-teaser
  .bd-service-item
  + .bd-service-item {

    padding-left: 38px;

    border-left:
      1px solid
      var(--bd-line);
  }

  /* =========================================================
     LEISTUNGS-TITEL
  ========================================================= */

  #bd-services-teaser .bd-service-title {
    margin:
      0
      0
      14px;

    color: var(--bd-dark);

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: 25px;
    font-weight: 400;
    line-height: 1.15;

    letter-spacing: -.015em;
  }

  /* =========================================================
     LEISTUNGS-TEXT
  ========================================================= */

  #bd-services-teaser .bd-service-text {
    max-width: 320px;

    margin: 0;

    color: var(--bd-text-soft);

    font-family:
      Arial,
      Helvetica,
      sans-serif;

    font-size: 13px;
    line-height: 1.7;
  }

  /* =========================================================
     CTA DIREKT IN "DIGITALE BETREUUNG"
  ========================================================= */

  #bd-services-teaser .bd-service-cta {
    position: relative;

    z-index: 20;

    display: inline-flex;

    align-items: center;

    align-self: flex-start;

    gap: 10px;

    max-width: 100%;

    margin-top: 22px;

    padding-bottom: 6px;

    color: #18181F !important;
    -webkit-text-fill-color: #18181F !important;

    text-decoration: none !important;

    font-family:
      Arial,
      Helvetica,
      sans-serif;

    font-size: 10px;

    font-weight: 600;

    line-height: 1.3;

    letter-spacing: .13em;

    text-transform: uppercase;

    border-bottom:
      1px solid
      var(--bd-copper);

    opacity: 1 !important;
    visibility: visible !important;

    filter: none !important;
    -webkit-filter: none !important;

    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;

    mix-blend-mode: normal !important;

    transition:
      color .25s ease,
      letter-spacing .25s ease;
  }

  #bd-services-teaser
  .bd-service-cta
  .bd-service-cta-text {

    color: #18181F !important;

    -webkit-text-fill-color:
      #18181F !important;

    opacity: 1 !important;

    filter: none !important;

    mix-blend-mode:
      normal !important;
  }

  #bd-services-teaser
  .bd-service-cta-arrow {

    color:
      var(--bd-copper) !important;

    -webkit-text-fill-color:
      var(--bd-copper) !important;

    font-size: 16px;

    line-height: 1;

    flex-shrink: 0;

    transition:
      transform .25s ease;
  }

  /* =========================================================
     CTA HOVER
  ========================================================= */

  #bd-services-teaser .bd-service-cta:hover,
  #bd-services-teaser .bd-service-cta:focus-visible,
  #bd-services-teaser .bd-service-cta:active {

    color:
      #18181F !important;

    -webkit-text-fill-color:
      #18181F !important;

    letter-spacing:
      .16em;
  }

  #bd-services-teaser
  .bd-service-cta:hover
  .bd-service-cta-text,

  #bd-services-teaser
  .bd-service-cta:focus-visible
  .bd-service-cta-text,

  #bd-services-teaser
  .bd-service-cta:active
  .bd-service-cta-text {

    color:
      #18181F !important;

    -webkit-text-fill-color:
      #18181F !important;
  }

  #bd-services-teaser
  .bd-service-cta:hover
  .bd-service-cta-arrow,

  #bd-services-teaser
  .bd-service-cta:focus-visible
  .bd-service-cta-arrow {

    color:
      var(--bd-copper) !important;

    -webkit-text-fill-color:
      var(--bd-copper) !important;

    transform:
      translateX(5px);
  }

  /* =========================================================
     TABLET
  ========================================================= */

  @media screen and (max-width: 990px) {

    #bd-services-teaser {

      width: 100%;
      max-width: 100%;

      background:
        linear-gradient(
          180deg,

          #18181F 0px,
          #29272A 22px,
          #5A5350 43px,
          #A79C94 64px,
          #D8CFC7 86px,
          #F3EDE6 110px,
          #F3EDE6 100%
        );

      padding:
        105px
        40px
        70px;

      box-sizing: border-box;

      overflow-x: clip;
    }

    #bd-services-teaser::before {

      top: -50px;

      left: 0;
      right: 0;

      width: 100%;

      height: 140px;

      filter: blur(19px);
      -webkit-filter: blur(19px);

      backdrop-filter: blur(5px);
      -webkit-backdrop-filter: blur(5px);

      transform: none;
    }

    #bd-services-teaser .bd-services-intro {

      grid-template-columns: 1fr;

      gap: 20px;

      margin-bottom: 38px;
    }

    #bd-services-teaser .bd-services-description {
      max-width: 680px;
    }

    #bd-services-teaser .bd-service-item {

      min-height: 220px;

      padding:
        32px
        25px;
    }

    #bd-services-teaser
    .bd-service-item:first-child {

      padding-left: 0;
    }

    #bd-services-teaser
    .bd-service-item
    + .bd-service-item {

      padding-left: 25px;
    }

    #bd-services-teaser .bd-service-cta {

      margin-top: 20px;

      font-size: 9px;

      letter-spacing: .12em;
    }

  }

  /* =========================================================
     MOBILE
  ========================================================= */

  @media screen and (max-width: 700px) {

    #bd-services-teaser {

      margin-top: -55px;

      width: 100%;
      max-width: 100%;

      box-sizing: border-box;

      background:
        linear-gradient(
          180deg,

          rgba(24, 24, 31, 0.88) 0px,

          #29272A 24px,
          #5A5350 45px,
          #A79C94 67px,
          #D8CFC7 88px,
          #F3EDE6 112px,
          #F3EDE6 100%
        );

      padding:
        108px
        22px
        96px;

      overflow-x: clip;

      isolation: isolate;
    }

    /* =======================================================
       MOBILE HERO → SERVICES BLUR
    ======================================================== */

    #bd-services-teaser::before {

      top: -60px;
      bottom: auto;

      left: 0;
      right: 0;

      width: 100%;
      height: 145px;

      box-sizing: border-box;

      background:
        linear-gradient(
          180deg,

          rgba(24, 24, 31, 0.00) 0%,

          rgba(24, 24, 31, 0.12) 14%,

          rgba(24, 24, 31, 0.36) 32%,

          rgba(24, 24, 31, 0.62) 48%,

          rgba(41, 39, 42, 0.68) 62%,

          rgba(90, 83, 80, 0.50) 75%,

          rgba(167, 156, 148, 0.26) 88%,

          rgba(216, 207, 199, 0.00) 100%
        );

      filter: blur(22px);
      -webkit-filter: blur(22px);

      backdrop-filter: blur(7px);
      -webkit-backdrop-filter: blur(7px);

      transform: none;

      z-index: 0;
    }

    #bd-services-teaser .bd-services-inner {

      position: relative;

      z-index: 5;

      width: 100%;
      max-width: 100%;

      min-width: 0;

      box-sizing: border-box;
    }

    #bd-services-teaser .bd-services-intro {

      width: 100%;

      min-width: 0;

      margin-bottom: 34px;
    }

    #bd-services-teaser .bd-services-kicker {

      font-size: 9px;

      letter-spacing: .17em;
    }

    #bd-services-teaser .bd-services-title {

      max-width: 100%;

      font-size:
        clamp(
          32px,
          9vw,
          42px
        );

      overflow-wrap: break-word;
    }

    #bd-services-teaser .bd-services-description {

      width: 100%;
      max-width: 100%;

      font-size: 14px;

      line-height: 1.7;

      overflow-wrap: break-word;
    }

    /* =======================================================
       MOBILE LEISTUNGEN
    ======================================================== */

    #bd-services-teaser .bd-services-grid {

      grid-template-columns:
        minmax(0, 1fr);

      position: relative;

      z-index: 5;

      width: 100%;
      max-width: 100%;

      min-width: 0;
    }

    #bd-services-teaser .bd-service-item {

      width: 100%;
      max-width: 100%;

      min-width: 0;

      min-height: 180px;

      padding:
        30px
        0;

      box-sizing: border-box;

      display: flex;

      flex-direction: column;

      justify-content: center;
    }

    #bd-services-teaser
    .bd-service-item
    + .bd-service-item {

      padding-left: 0;

      border-left: 0;

      border-top:
        1px solid
        var(--bd-line);
    }

    #bd-services-teaser .bd-service-title {

      font-size: 24px;

      margin-bottom: 11px;
    }

    #bd-services-teaser .bd-service-text {

      width: 100%;
      max-width: 100%;

      overflow-wrap: break-word;
    }

    /* =======================================================
       MOBILE CTA IM DRITTEN KÄSTCHEN
    ======================================================== */

    #bd-services-teaser .bd-service-cta {

      position: relative;

      z-index: 20;

      align-self: flex-start;

      margin-top: 20px;

      font-size: 10px;

      letter-spacing: .13em;

      color:
        #18181F !important;

      -webkit-text-fill-color:
        #18181F !important;

      opacity:
        1 !important;

      visibility:
        visible !important;

      filter:
        none !important;

      -webkit-filter:
        none !important;

      backdrop-filter:
        none !important;

      -webkit-backdrop-filter:
        none !important;

      mix-blend-mode:
        normal !important;
    }

    #bd-services-teaser
    .bd-service-cta
    .bd-service-cta-text {

      color:
        #18181F !important;

      -webkit-text-fill-color:
        #18181F !important;
    }

    #bd-services-teaser
    .bd-service-cta-arrow {

      color:
        var(--bd-copper) !important;

      -webkit-text-fill-color:
        var(--bd-copper) !important;
    }

  }

  /* =========================================================
     SMALL MOBILE
  ========================================================= */

  @media screen and (max-width: 480px) {

    #bd-services-teaser {

      padding-bottom: 105px;
    }

    #bd-services-teaser .bd-service-cta {

      font-size: 10px;

      letter-spacing: .12em;

      gap: 9px;
    }

  }

  /* =========================================================
     REDUCED MOTION
  ========================================================= */

  @media (prefers-reduced-motion: reduce) {

    #bd-services-teaser .bd-service-cta,
    #bd-services-teaser .bd-service-cta-arrow {

      transition:
        none !important;
    }

  }

</style>

<section
  id="bd-services-teaser"
  aria-labelledby="bd-services-title"
>

  <div class="bd-services-inner">

    <!-- INTRO -->

    <div class="bd-services-intro">

      <div>

        <div class="bd-services-kicker">
          Leistungen
        </div>

        <h2
          class="bd-services-title"
          id="bd-services-title"
        >
          Digitale Lösungen,<br>
          die zu deinem Business passen.
        </h2>

      </div>

      <p class="bd-services-description">

        Von der professionellen Website über den Online-Shop
        bis zur laufenden Betreuung – ich entwickle digitale
        Auftritte, die durchdacht aussehen und im Alltag
        funktionieren.

      </p>

    </div>

    <!-- LEISTUNGEN -->

    <div class="bd-services-grid">

      <!-- WEBSITE -->

      <article class="bd-service-item">

        <h3 class="bd-service-title">
          Websites
        </h3>

        <p class="bd-service-text">

          Individuelle, moderne Websites für Unternehmen,
          die professionell auftreten und Vertrauen schaffen
          wollen.

        </p>

      </article>

      <!-- ONLINE-SHOPS -->

      <article class="bd-service-item">

        <h3 class="bd-service-title">
          Online-Shops
        </h3>

        <p class="bd-service-text">

          Durchdachte Shops, die Produkte klar präsentieren
          und den Kaufprozess einfach machen.

        </p>

      </article>

      <!-- DIGITALE BETREUUNG + CTA -->

      <article class="bd-service-item">

        <h3 class="bd-service-title">
          Digitale Betreuung
        </h3>

        <p class="bd-service-text">

          Weiterentwicklung, Anpassungen und Unterstützung
          auch nach dem Launch.

        </p>

        <a
          href="/leistungen"
          class="bd-service-cta"
        >

          <span class="bd-service-cta-text">
            Alle Leistungen entdecken
          </span>

          <span
            class="bd-service-cta-arrow"
            aria-hidden="true"
          >
            →
          </span>

        </a>

      </article>

    </div>

  </div>

</section>
