<style is:global>
/* =========================================================
   BRÄUER.DIGITAL – ÜBER MICH TEASER
   NEUES DESIGN + BEWÄHRTER SECTION-ÜBERGANG
========================================================= */

#bd-about-teaser {
  --bd-dark: #0A0D11;
  --bd-copper: #C78A6A;
  --bd-white: #F7F5F2;
  --bd-cream: #F3EDE6;
  --bd-text: rgba(243,237,230,.76);

  position: relative;

  width: 100%;
  max-width: 100%;

  box-sizing: border-box;

  /*
    Wie bei der funktionierenden alten Section:
    Section überlappt die vorherige Section.
  */
  margin-top: -55px;

  /* =====================================================
     DER ENTSCHEIDENDE ÜBERGANG

     Exakt nach dem Prinzip deines alten Codes:

     transparentes Creme
            ↓
     helles Creme
            ↓
     warmes Grau / Taupe
            ↓
     dunkles Grau
            ↓
     Anthrazit
            ↓
     #0A0D11
  ====================================================== */

  background:
    linear-gradient(
      180deg,

      rgba(243,237,230,0.00) 0px,
      rgba(243,237,230,0.88) 20px,

      #D8CFC7 46px,
      #A79C94 72px,
      #5A5350 100px,
      #29272A 128px,
      #141519 155px,

      #0A0D11 185px,
      #0A0D11 100%
    );

  /*
    Der Content beginnt erst NACH
    dem vollständigen Übergang.
  */
  padding:
    230px
    6%
    95px;

  /*
    Kein horizontaler Überlauf.
    Vertikal darf der Blur nach oben reichen.
  */
  overflow-x: clip;
  overflow-y: visible;

  isolation: isolate;

  z-index: 2;
}

/* =========================================================
   BLUR-SCHICHT ÜBER DEM FARBVERLAUF

   Ebenfalls direkt nach dem Prinzip
   des alten funktionierenden Codes.
========================================================= */

#bd-about-teaser::before {
  content: "";

  position: absolute;

  top: -58px;
  left: 0;
  right: 0;

  width: 100%;
  height: 175px;

  box-sizing: border-box;

  pointer-events: none;

  background:
    linear-gradient(
      180deg,

      rgba(243,237,230,0.00) 0%,

      rgba(243,237,230,0.14) 14%,

      rgba(216,207,199,0.32) 30%,

      rgba(167,156,148,0.44) 47%,

      rgba(90,83,80,0.54) 63%,

      rgba(41,39,42,0.58) 79%,

      rgba(10,13,17,0.00) 100%
    );

  filter: blur(24px);
  -webkit-filter: blur(24px);

  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);

  transform: none;

  z-index: 0;
}

/* =========================================================
   WEICHE UNTERKANTE

   Die Section endet ebenfalls nicht mit
   einer optisch harten Linie.
========================================================= */

#bd-about-teaser::after {
  content: "";

  position: absolute;

  left: 0;
  right: 0;

  bottom: -42px;

  width: 100%;
  height: 100px;

  pointer-events: none;

  background:
    linear-gradient(
      180deg,

      #0A0D11 0%,
      rgba(10,13,17,.96) 25%,
      rgba(10,13,17,.78) 50%,
      rgba(10,13,17,.38) 75%,
      rgba(10,13,17,0) 100%
    );

  filter: blur(20px);
  -webkit-filter: blur(20px);

  z-index: 0;
}

/* =========================================================
   INNER
========================================================= */

#bd-about-teaser .bd-about-inner {
  position: relative;

  z-index: 2;

  width: min(1380px, 100%);
  max-width: 100%;
  min-width: 0;

  margin: 0 auto;

  box-sizing: border-box;
}

/* =========================================================
   WASSERZEICHEN
========================================================= */

#bd-about-teaser .bd-about-watermark {
  position: absolute;

  z-index: 0;

  top: 50%;
  right: -3%;

  transform: translateY(-50%);

  width: clamp(430px, 39vw, 650px);
  height: auto;

  display: block;

  /*
    Noch sichtbar genug, aber eindeutig
    als Hintergrund/Wasserzeichen.
  */
  opacity: .18;

  pointer-events: none;
  user-select: none;

  filter:
    saturate(.80)
    brightness(.76);

  -webkit-filter:
    saturate(.80)
    brightness(.76);
}

/* =========================================================
   WASSERZEICHEN LINKS SANFT EINBLENDEN
========================================================= */

#bd-about-teaser .bd-about-watermark-fade {
  position: absolute;

  z-index: 1;

  top: 0;
  right: 0;
  bottom: 0;

  width: 44%;

  pointer-events: none;

  background:
    linear-gradient(
      90deg,

      #0A0D11 0%,
      rgba(10,13,17,.76) 11%,
      rgba(10,13,17,.24) 29%,
      rgba(10,13,17,0) 54%
    );
}

/* =========================================================
   CONTENT
========================================================= */

#bd-about-teaser .bd-about-content {
  position: relative;

  z-index: 3;

  width: 67%;
  max-width: 890px;
  min-width: 0;
}

/* =========================================================
   KICKER
========================================================= */

#bd-about-teaser .bd-about-kicker {
  position: relative;

  display: inline-block;

  margin:
    0
    0
    40px;

  padding-bottom: 15px;

  color: rgba(243,237,230,.78);

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 11px;
  font-weight: 500;

  line-height: 1.3;

  letter-spacing: .20em;

  text-transform: uppercase;
}

#bd-about-teaser .bd-about-kicker::after {
  content: "";

  position: absolute;

  left: 0;
  bottom: 0;

  width: 62px;
  height: 2px;

  background: var(--bd-copper);
}

/* =========================================================
   HEADLINE
========================================================= */

#bd-about-teaser .bd-about-title {
  margin:
    0
    0
    18px;

  max-width: 100%;

  color: var(--bd-white);

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    clamp(
      58px,
      6.3vw,
      94px
    );

  font-weight: 400;

  line-height: .98;

  letter-spacing: -.045em;

  overflow-wrap: break-word;
}

#bd-about-teaser .bd-about-title-line {
  display: block;
}

#bd-about-teaser .bd-about-title-accent {
  display: block;

  color: var(--bd-copper);
}

/* =========================================================
   STATEMENT
========================================================= */

#bd-about-teaser .bd-about-statement {
  margin:
    0
    0
    23px;

  color: rgba(243,237,230,.83);

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 15px;
  font-weight: 500;

  line-height: 1.65;

  letter-spacing: .21em;

  text-transform: uppercase;
}

#bd-about-teaser .bd-about-statement-accent {
  display: block;

  color: var(--bd-copper);
}

/* =========================================================
   KUPFERLINIE
========================================================= */

#bd-about-teaser .bd-about-divider {
  width: 62px;
  height: 2px;

  margin:
    0
    0
    23px;

  background: var(--bd-copper);
}

/* =========================================================
   BESCHREIBUNG
========================================================= */

#bd-about-teaser .bd-about-text {
  max-width: 610px;

  margin:
    0
    0
    28px;

  color: var(--bd-text);

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 17px;
  font-weight: 400;

  line-height: 1.7;

  letter-spacing: .015em;
}

/* =========================================================
   BUTTON
========================================================= */

#bd-about-teaser .bd-about-link {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  gap: 30px;

  min-width: 250px;

  box-sizing: border-box;

  padding:
    16px
    25px;

  color: var(--bd-copper);

  border:
    1px solid
    var(--bd-copper);

  text-decoration: none;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 11px;
  font-weight: 500;

  line-height: 1;

  letter-spacing: .16em;

  text-transform: uppercase;

  background:
    rgba(10,13,17,.18);

  transition:
    background .25s ease,
    color .25s ease,
    transform .25s ease;
}

#bd-about-teaser .bd-about-arrow {
  font-size: 22px;

  line-height: 1;

  transition:
    transform .25s ease;
}

#bd-about-teaser .bd-about-link:hover,
#bd-about-teaser .bd-about-link:focus-visible {
  background: var(--bd-copper);

  color: var(--bd-dark);
}

#bd-about-teaser
.bd-about-link:hover
.bd-about-arrow,

#bd-about-teaser
.bd-about-link:focus-visible
.bd-about-arrow {
  transform: translateX(5px);
}

/* =========================================================
   TABLET
========================================================= */

@media screen and (max-width: 990px) {

  #bd-about-teaser {
    margin-top: -50px;

    background:
      linear-gradient(
        180deg,

        rgba(243,237,230,0.00) 0px,
        rgba(243,237,230,0.88) 18px,

        #D8CFC7 40px,
        #A79C94 62px,
        #5A5350 86px,
        #29272A 112px,
        #141519 138px,

        #0A0D11 165px,
        #0A0D11 100%
      );

    padding:
      205px
      40px
      82px;

    overflow-x: clip;
  }

  #bd-about-teaser::before {
    top: -52px;

    height: 150px;

    filter: blur(22px);
    -webkit-filter: blur(22px);
  }

  #bd-about-teaser::after {
    bottom: -36px;

    height: 90px;

    filter: blur(18px);
    -webkit-filter: blur(18px);
  }

  #bd-about-teaser .bd-about-content {
    width: 72%;

    max-width: 720px;
  }

  #bd-about-teaser .bd-about-watermark {
    right: -10%;

    width:
      clamp(
        390px,
        50vw,
        540px
      );

    opacity: .17;
  }

  #bd-about-teaser .bd-about-title {
    font-size:
      clamp(
        52px,
        7vw,
        72px
      );
  }

  #bd-about-teaser .bd-about-text {
    font-size: 16px;
  }

}

/* =========================================================
   MOBILE
========================================================= */

@media screen and (max-width: 700px) {

  #bd-about-teaser {
    margin-top: -48px;

    width: 100%;
    max-width: 100%;

    box-sizing: border-box;

    /* =====================================================
       EXAKT DAS MOBILE-ÜBERGANGSPRINZIP
       AUS DEINEM ALTEN CODE
    ====================================================== */

    background:
      linear-gradient(
        180deg,

        rgba(243,237,230,0.00) 0px,
        rgba(243,237,230,0.90) 16px,

        #D8CFC7 34px,
        #A79C94 54px,
        #5A5350 75px,
        #29272A 98px,
        #141519 121px,

        #0A0D11 148px,
        #0A0D11 100%
      );

    padding:
      180px
      22px
      68px;

    overflow-x: clip;

    isolation: isolate;
  }

  /* =====================================================
     MOBILE BLUR OBEN
  ====================================================== */

  #bd-about-teaser::before {
    top: -54px;

    left: 0;
    right: 0;

    width: 100%;
    height: 140px;

    box-sizing: border-box;

    background:
      linear-gradient(
        180deg,

        rgba(243,237,230,0.00) 0%,

        rgba(243,237,230,0.16) 14%,

        rgba(216,207,199,0.34) 31%,

        rgba(167,156,148,0.46) 48%,

        rgba(90,83,80,0.50) 65%,

        rgba(41,39,42,0.40) 81%,

        rgba(10,13,17,0.00) 100%
      );

    filter: blur(20px);
    -webkit-filter: blur(20px);

    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);

    transform: none;
  }

  /* =====================================================
     MOBILE UNTERER BLUR
  ====================================================== */

  #bd-about-teaser::after {
    bottom: -30px;

    height: 78px;

    background:
      linear-gradient(
        180deg,

        #0A0D11 0%,

        rgba(10,13,17,.92) 28%,

        rgba(10,13,17,.66) 55%,

        rgba(10,13,17,.26) 79%,

        rgba(10,13,17,0) 100%
      );

    filter: blur(16px);
    -webkit-filter: blur(16px);
  }

  /* =====================================================
     MOBILE WASSERZEICHEN
  ====================================================== */

  #bd-about-teaser .bd-about-watermark {
    top: 49%;

    right: -30%;

    width: 90vw;
    max-width: 470px;

    opacity: .15;

    transform:
      translateY(-50%);

    filter:
      saturate(.76)
      brightness(.72);

    -webkit-filter:
      saturate(.76)
      brightness(.72);
  }

  #bd-about-teaser .bd-about-watermark-fade {
    width: 58%;

    background:
      linear-gradient(
        90deg,

        #0A0D11 0%,

        rgba(10,13,17,.72) 15%,

        rgba(10,13,17,.20) 43%,

        rgba(10,13,17,0) 74%
      );
  }

  /* =====================================================
     MOBILE CONTENT
  ====================================================== */

  #bd-about-teaser .bd-about-content {
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  #bd-about-teaser .bd-about-kicker {
    margin-bottom: 32px;

    padding-bottom: 13px;

    font-size: 9px;

    letter-spacing: .18em;
  }

  #bd-about-teaser .bd-about-kicker::after {
    width: 48px;
  }

  /* =====================================================
     MOBILE HEADLINE
  ====================================================== */

  #bd-about-teaser .bd-about-title {
    margin-bottom: 20px;

    font-size:
      clamp(
        47px,
        14vw,
        65px
      );

    line-height: .98;

    letter-spacing: -.04em;
  }

  /* =====================================================
     MOBILE STATEMENT
  ====================================================== */

  #bd-about-teaser .bd-about-statement {
    max-width: 94%;

    margin-bottom: 21px;

    font-size: 11px;

    line-height: 1.75;

    letter-spacing: .18em;
  }

  #bd-about-teaser .bd-about-divider {
    width: 48px;

    margin-bottom: 21px;
  }

  /* =====================================================
     MOBILE TEXT
  ====================================================== */

  #bd-about-teaser .bd-about-text {
    max-width: 90%;

    margin-bottom: 27px;

    font-size: 14px;

    line-height: 1.7;
  }

  /* =====================================================
     MOBILE BUTTON
  ====================================================== */

  #bd-about-teaser .bd-about-link {
    min-width: 225px;

    padding:
      15px
      21px;

    gap: 25px;

    font-size: 10px;
  }

}

/* =========================================================
   VERY SMALL MOBILE
========================================================= */

@media screen and (max-width: 420px) {

  #bd-about-teaser {
    padding:
      172px
      18px
      62px;
  }

  #bd-about-teaser .bd-about-title {
    font-size:
      clamp(
        43px,
        13.5vw,
        57px
      );
  }

  #bd-about-teaser .bd-about-statement {
    max-width: 100%;

    font-size: 10px;

    letter-spacing: .16em;
  }

  #bd-about-teaser .bd-about-text {
    max-width: 94%;

    font-size: 13.5px;
  }

  #bd-about-teaser .bd-about-watermark {
    right: -38%;

    width: 103vw;

    opacity: .14;
  }

}

/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {

  #bd-about-teaser .bd-about-link,
  #bd-about-teaser .bd-about-arrow {
    transition: none !important;
  }

}

</style>

<!-- =========================================================
     BRÄUER.DIGITAL – ÜBER MICH TEASER
========================================================= -->

<section
  id="bd-about-teaser"
  aria-labelledby="bd-about-title"
>

  <div class="bd-about-inner">

    <!-- =====================================================
         WASSERZEICHEN
    ====================================================== -->

    <img
      src="/images/wasserzeichen.png"
      class="bd-about-watermark"
      alt=""
      aria-hidden="true"
      loading="lazy"
    >

    <!--
      Das Wasserzeichen wird auf der linken Seite
     sanft in #0A0D11 eingeblendet.
    -->

    <div
      class="bd-about-watermark-fade"
      aria-hidden="true"
    ></div>

    <!-- =====================================================
         CONTENT
    ====================================================== -->

    <div class="bd-about-content">

      <!-- BRAND -->

      <div class="bd-about-kicker">
        Bräuer.Digital
      </div>

      <!-- HEADLINE -->

      <h2
        class="bd-about-title"
        id="bd-about-title"
      >

        <span class="bd-about-title-line">
          Digital darf
        </span>

        <span class="bd-about-title-accent">
          persönlich sein.
        </span>

      </h2>

      <!-- STATEMENT -->

      <p class="bd-about-statement">

        Gutes Webdesign beginnt darin,

        <span class="bd-about-statement-accent">
          dein Unternehmen zu verstehen.
        </span>

      </p>

      <!-- KUPFERLINIE -->

      <div
        class="bd-about-divider"
        aria-hidden="true"
      ></div>

      <!-- BESCHREIBUNG -->

      <p class="bd-about-text">

        Webdesign mit einem Menschen dahinter.<br>

        Strategie, Design und Umsetzung – individuell,<br>

        durchdacht und auf Augenhöhe.

      </p>

      <!-- BUTTON -->

      <a
        href="/ueber-mich"
        class="bd-about-link"
      >

        <span>
          Mehr über mich
        </span>

        <span
          class="bd-about-arrow"
          aria-hidden="true"
        >
          →
        </span>

      </a>

    </div>

  </div>

</section>
